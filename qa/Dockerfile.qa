FROM node:20-bookworm

WORKDIR /qa
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# --- System dependencies + git ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    curl \
    unzip \
    wget \
    default-jre \
    python3 \
    python3-pip \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# --- Go 1.25 (for running backend unit tests) ---
RUN curl -sSL https://go.dev/dl/go1.25.0.linux-amd64.tar.gz | tar -C /usr/local -xzf -
ENV PATH="/usr/local/go/bin:${PATH}"
RUN go install github.com/boumenot/gocover-cobertura@latest \
    && mv /root/go/bin/gocover-cobertura /usr/local/bin/

# --- pnpm (for running frontend unit tests) ---
RUN corepack enable && corepack prepare pnpm@latest --activate

# --- Newman (API testing) ---
RUN --mount=type=cache,target=/root/.npm \
    npm install -g newman newman-reporter-allure

# --- Playwright (UI testing) ---
RUN --mount=type=cache,target=/root/.npm \
    npm install -g playwright
RUN npx playwright install --with-deps chromium

# --- Google Chrome Stable (requerido por Lighthouse CLI) ---
# Playwright instala Chromium (sin /usr/bin/google-chrome-stable).
# Lighthouse necesita el binario de Chrome real para sus auditorías.
RUN wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

# --- k6 (Performance testing) ---
RUN curl -sSLo /tmp/k6.deb https://github.com/grafana/k6/releases/download/v0.50.0/k6-v0.50.0-linux-amd64.deb \
    && dpkg -i /tmp/k6.deb \
    && rm /tmp/k6.deb

# --- OWASP ZAP (Security testing) ---
# Nota: ZAP completo requiere ~500MB y Java. Los scripts standalone necesitan el daemon.
# Opción 1: Usar ZAP como sidecar container (recomendado para CI/CD)
# Opción 2: Instalar solo el cliente Python para interactuar con ZAP externo
# Por ahora instalamos el cliente Python - ZAP se ejecutará como sidecar si está disponible
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --break-system-packages python-owasp-zap-v2.4 requests

# Crear script wrapper para ZAP que use el sidecar o muestre mensaje informativo
RUN mkdir -p /opt/zap && cat > /opt/zap/zap-wrapper.sh <<'ZAPWRAPPER'
#!/bin/bash
# Wrapper para OWASP ZAP - intenta conectar al sidecar ZAP
ZAP_HOST="${ZAP_HOST:-zap}"
ZAP_PORT="${ZAP_PORT:-8080}"
ZAP_API_KEY="${ZAP_API_KEY:-}"

echo "Intentando conectar a ZAP en $ZAP_HOST:$ZAP_PORT..."

# Verificar si ZAP sidecar está disponible
if curl -sf "http://$ZAP_HOST:$ZAP_PORT/" > /dev/null 2>&1; then
    echo "✓ ZAP sidecar disponible"
    export ZAP_AVAILABLE=true
else
    echo "⚠ ZAP sidecar no disponible. Ejecute el contenedor ZAP como sidecar:"
    echo "  docker run -d --name zap --network qa-network -p 8080:8080 ghcr.io/zaproxy/zaproxy:stable zap.sh -daemon -host 0.0.0.0 -port 8080"
    export ZAP_AVAILABLE=false
fi
ZAPWRAPPER
RUN chmod +x /opt/zap/zap-wrapper.sh \
    && ln -sf /opt/zap/zap-wrapper.sh /usr/local/bin/zap-check

# --- Sonar Scanner ---
RUN curl -sSLo /tmp/sonar-scanner.zip https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-6.2.1.4610-linux-x64.zip \
    && unzip /tmp/sonar-scanner.zip -d /opt \
    && mv /opt/sonar-scanner-* /opt/sonar-scanner \
    && ln -s /opt/sonar-scanner/bin/sonar-scanner /usr/local/bin/sonar-scanner \
    && rm /tmp/sonar-scanner.zip

# --- QA project dependencies ---
COPY qa/package.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm install

# --- Copy QA project files ---
COPY qa/ /qa/

# --- Copy project sources (configurable via build args) ---
ARG BACKEND_DIR=BACKEND
ARG FRONTEND_DIR=FRONTEND
COPY ${BACKEND_DIR}/ /src/backend/
COPY ${FRONTEND_DIR}/ /src/frontend/

# Fix CRLF issues (Windows line endings) that break bash scripts
RUN sed -i 's/\r$//' /qa/run-tests.sh /qa/run-tests_fuc.sh \
    && chmod +x /qa/run-tests.sh /qa/run-tests_fuc.sh

CMD ["bash", "run-tests.sh"]
